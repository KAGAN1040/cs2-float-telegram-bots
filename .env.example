# Bu dosyayi .env adi ile kopyala ve KENDI bilgilerini gir.
# .env dosyasini GitHub'a yukleme!

# Telegram: @BotFather tarafindan verilen token ve kendi Telegram chat ID'n.
# Iki bot da varsayilan olarak ayni Telegram botunu / chat ID'sini kullanir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Farkli Telegram botlari / sohbetleri kullanmak icin bunlari acabilirsin:
# EMPIRE_TELEGRAM_BOT_TOKEN=
# EMPIRE_TELEGRAM_CHAT_ID=
# BYNO_TELEGRAM_BOT_TOKEN=
# BYNO_TELEGRAM_CHAT_ID=

# ---------- CSGOEmpire botu ----------
# Kendi CSGOEmpire API key'in. BynoGame icin gerekli degil.
EMPIRE_API_KEY=
EMPIRE_API_DOMAIN=csgoempire.com
MAX_FLOAT=0.05
MIN_DECIMALS=3
MAX_PRICE_COINS=0
SKIN_KEYWORDS=

# ---------- BynoGame botu ----------
# Kontrol araligi saniye cinsinden (en az 5).
BYNO_CHECK_INTERVAL=20
# 3 anlamli ondalik icin 0.003000 gecer, 0.030000 gecmez.
BYNO_MIN_DECIMALS=3
# 1 = max float siniri yok (0..1). Ornegin 0.05 yazabilirsin.
BYNO_MAX_FLOAT=1
# 0 = fiyat siniri yok.
BYNO_MAX_PRICE_TL=0
# Bos = tum skinler. Ornek: AK-47,AWP
BYNO_SKIN_KEYWORDS=
# Her sorguda kontrol edilen son ilan sayisi (1..100).
BYNO_PAGE_SIZE=20
